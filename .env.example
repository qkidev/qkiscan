# 链展示名称（Header）
VITE_APP_CHAIN_NAME=My Chain

# 默认语言：en | zh-CN | zh-TW（无 URL/lang、无 localStorage、无法解析浏览器语言时使用）
VITE_APP_DEFAULT_LANG=en

# 预留：主题切换
VITE_APP_ENABLE_THEME=false

# 预留：是否展示原生币价格等
VITE_APP_ENABLE_PRICE=true

# API 根地址（axios baseURL，会与代码里的 /v2/... 拼成「根 + /v2/...」）
# · 使用反向代理、与站点同源时：用相对路径，由 Nginx/Caddy 把 /api 转到 Blockscout
#   VITE_APP_API_BASE=/api
# · 浏览器直连 Blockscout、不用反代时：填完整 URL，须包含 Blockscout 的 /api 前缀，无尾部斜杠，且链上需允许 CORS
#   VITE_APP_API_BASE=https://eth.blockscout.com/api
VITE_APP_API_BASE=/api

# 原生币符号（展示原生币余额/金额时追加在数值后，如 ETH、BNB、MATIC；留空则只显示数值）
VITE_APP_NATIVE_SYMBOL=

# 本地开发：Vite 将 /api、/socket 代理到该 Blockscout 源站（勿提交真实内网地址到公开仓库时可留空并在本地 .env 填写）
VITE_DEV_BLOCKSCOUT_ORIGIN=http://127.0.0.1:4000

# Google Analytics 4 衡量 ID（格式 G-xxxxxxxxxx），留空则不加载统计
# VITE_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX
